tools/rack-drawing/*.svg
tools/rack-drawing/build/*
!tools/rack-drawing/build/.gitkeep

# =============================================================================
# macOS Visualiser (Xcode/Swift)
# =============================================================================
# Build artifacts
tools/visualiser-macos/.build/
tools/visualiser-macos/build/
tools/visualiser-macos/DerivedData/

# Test results
tools/visualiser-macos/TestResults*

# User-specific Xcode data
tools/visualiser-macos/**/xcuserdata/

# Swift Package Manager
tools/visualiser-macos/.swiftpm/
tools/visualiser-macos/Packages/

# Generated protobuf files (regenerate with: make proto-gen-swift)
tools/visualiser-macos/VelocityVisualiser/gRPC/Generated/*.swift
tools/visualiser-macos/VelocityVisualiser/gRPC/Generated/*.swift.disabled

# Generated at build time (rotates on every build); a placeholder is checked
# in so the file exists, but the real output must not pollute commits
tools/visualiser-macos/VelocityVisualiser/App/BuildInfo.swift

