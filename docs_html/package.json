{
  "name": "velocity-report-offline-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Embedded offline documentation site for velocity.report",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve --port=8093",
    "clean": "rm -rf _site"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "license": "CC-BY-4.0",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "cheerio": "1.2.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "11.15.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.11",
      "uuid": "^11.1.1"
    }
  }
