{#
  The full tree is rendered once into assets/docs-tree.html (src/docs-tree.njk)
  and loaded by assets/docs-tree.js. Inlining it here put ~180 KB into every
  page. Without JavaScript the breadcrumbs and folder index pages still
  navigate.
#}
<nav class="nav" aria-label="Documentation tree" data-doc-tree-src="{{ docsTreeURL | docsRelativeUrl(page.url) }}">
  <noscript>
    <p class="tree-status">The documentation tree needs JavaScript. Use the breadcrumbs above the
    page, or start from the <a href="{{ "/" | docsRelativeUrl(page.url) }}" data-docs-internal>offline docs index</a>.</p>
  </noscript>
</nav>
<script src="{{ "/assets/docs-tree.js" | docsRelativeUrl(page.url) }}" defer></script>
