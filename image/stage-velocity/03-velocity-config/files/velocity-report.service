[Unit]
Description=Velocity.report radar monitor service
After=network.target

[Service]
User=velocity
Group=velocity
Type=simple

# Bind the privileged HTTP port :80 as the non-root `velocity` user.
# AmbientCapabilities grants CAP_NET_BIND_SERVICE to the started process;
# CapabilityBoundingSet caps the bounding set to exactly that one capability.
# No setcap on the binary, no root — survives binary upgrades cleanly.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --listen :80 is passed explicitly because the binary default is
# 127.0.0.1:8080 (loopback only) — a deliberately safe default that does not
# expose the server on the LAN.  Production opts in to LAN access by binding
# :80 on all interfaces here; CAP_NET_BIND_SERVICE (granted above) lets the
# non-root `velocity` user bind the privileged port.  The result is
# http://velocity.local; HTTPS is an opt-in via Tailscale Serve (see
# docs/platform/operations/tailscale-serve.md).
#
# --port is omitted: its default /dev/ttySC1 (Waveshare SC16IS752 HAT,
# channel B) already matches this deployment.  Override it if the path differs.
ExecStart=/usr/local/bin/velocity-report --listen :80 --db-path /var/lib/velocity-report/sensor_data.db --config /opt/velocity-report/config/tuning.defaults.json
WorkingDirectory=/var/lib/velocity-report
Environment="VELOCITY_PDF_BACKEND=go"
Environment="VELOCITY_TEX_ROOT=/opt/velocity-report/texlive"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=velocity-report

[Install]
WantedBy=multi-user.target
