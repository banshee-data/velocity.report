{
  "name": "velocity.report",
  "version": "0.0.0",
  "description": "https://velocity.report",
  "main": "index.js",
  "scripts": {
    "start": "pnpm run dev",
    "dev": "npm-run-all --npm-path pnpm --parallel dev:*",
    "dev:eleventy": "eleventy --serve --port=8090",
    "dev:css": "tailwindcss -i ./src/css/style.css -o ./_site/css/style.css --watch",
    "build": "npm-run-all --npm-path pnpm build:css build:eleventy",
    "build:css": "tailwindcss -i ./src/css/style.css -o ./_site/css/style.css --minify",
    "build:eleventy": "eleventy",
    "clean": "rm -rf _site"
  },
  "keywords": [],
  "author": "Banshee, INC.",
  "license": "CC-BY-4.0",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "three": "0.185.1"
  }
}
