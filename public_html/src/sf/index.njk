---
permalink: /sf/
title: "Drive San Francisco: velocity.report"
description: "Drive anywhere in San Francisco over measured geometry: buildings and roofs from USGS 3DEP lidar and DataSF footprints, street trees, roads with kerbs, and street-name signposts."
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<style>
  /* Full-viewport drive: the 3D view fills the page; the readout, controls and mirror float over it. */
  :root {
    --bg: #eef1f3; --panel: rgba(255, 255, 255, 0.92); --ink: #17202a; --muted: #56636c; --rule: #d3d9dd; --accent: #0f766e;
    --sky: #cfdde6; --land: #b4b7a5; --roof: #d9cdb8; --wall: #e6e1d7; --extra: #8b74c9;
    --asphalt: #4a4f55; --path: #b7b2a6; --dash: #f2d36b; --kerb: #eeece6;
    --tree: #5f8a4e; --trunk: #6b5a45; --pole: #5f666c; --sign: #1f6f43; --car: #0f766e; --car-dark: #0b4f4a;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #11161a; --panel: rgba(24, 32, 38, 0.92); --ink: #e2e7ea; --muted: #98a5ad; --rule: #2b363e; --accent: #34d399;
      --sky: #1c2a33; --land: #5b5f55; --roof: #b4a890; --wall: #c9c3b7; --extra: #a28fe0;
      --asphalt: #2a2e33; --path: #6d6b65; --dash: #d9b94a; --kerb: #c9c6bd;
      --tree: #6f9a5c; --trunk: #5a4a39; --pole: #9aa3a9; --sign: #217a4a; --car: #2dd4bf; --car-dark: #138a7c;
    }
  }
  html, body { height: 100%; margin: 0; }
  body { background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; overflow: hidden; }
  #drive { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .panel { position: fixed; background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 10px 12px; }
  .where { left: max(12px, env(safe-area-inset-left, 0px)); top: max(12px, env(safe-area-inset-top, 0px)); min-width: 210px; max-width: 42vw; display: grid; gap: 4px; }
  .where .street { font-weight: 700; font-size: 18px; }
  .where .next { color: var(--muted); min-height: 1.2em; }
  .where .meta { display: flex; gap: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .where .speed { color: var(--ink); font-weight: 600; }
  .tools { right: max(12px, env(safe-area-inset-right, 0px)); top: max(12px, env(safe-area-inset-top, 0px)); display: grid; gap: 8px; max-width: 260px; }
  .tools label { font-size: 12px; color: var(--muted); }
  .tools select { width: 100%; font: inherit; padding: 6px; border-radius: 6px; border: 1px solid var(--rule); background: var(--panel); color: var(--ink); }
  .tools .row { display: flex; gap: 6px; }
  .tools button, .pad button { font: 600 13px/1 inherit; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--rule); background: var(--panel); color: var(--ink); cursor: pointer; }
  .tools button[aria-pressed="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
  .quest { left: max(12px, env(safe-area-inset-left, 0px)); top: 128px; width: 240px; display: grid; gap: 6px; }
  .quest .title, .map .title { font-weight: 700; }
  .quest .timer { font: 700 28px/1.2 ui-monospace, monospace; font-variant-numeric: tabular-nums; }
  .quest progress { width: 100%; height: 7px; accent-color: var(--accent); }
  .quest .target { font-weight: 600; }
  .quest .detail, .map .detail { color: var(--muted); font-size: 11px; }
  .quest .status { font-size: 12px; min-height: 2.8em; }
  .seeker { display: flex; align-items: center; gap: 10px; border-block: 1px solid var(--rule); padding: 5px 0; }
  #seekerCompass { width: 88px; height: 88px; display: block; flex: none; }
  .seeker-copy { display: grid; gap: 3px; min-width: 0; }
  .seeker-copy strong { font-size: 12px; }
  #seekerDistance { font-weight: 700; font-variant-numeric: tabular-nums; }
  #seekerHeading { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  button:disabled { opacity: 0.5; cursor: default; }
  .map { right: max(12px, env(safe-area-inset-right, 0px)); bottom: max(12px, env(safe-area-inset-bottom, 0px)); width: 260px; }
  #minimap { display: block; width: 100%; height: 235px; }
  .map .legend { display: flex; gap: 10px; font-size: 11px; }
  .map .loaded { color: #0f9383; } .map .collected { color: #b38120; }
  button:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mirror { position: fixed; border: 3px solid #111; border-radius: 10px; pointer-events: none; box-shadow: 0 2px 8px rgba(0,0,0,.35); }
  .help { left: max(12px, env(safe-area-inset-left, 0px)); bottom: max(12px, env(safe-area-inset-bottom, 0px)); max-width: min(560px, calc(100vw - 340px)); font-size: 12px; color: var(--muted); }
  .help p { margin: 0 0 4px; }
  .help a { color: var(--accent); }
  .pad { position: fixed; right: max(12px, env(safe-area-inset-right, 0px)); bottom: max(12px, env(safe-area-inset-bottom, 0px)); display: none; grid-template-columns: repeat(3, 56px); gap: 6px; }
  .pad button { height: 56px; font-size: 18px; }
  kbd { font: 11px ui-monospace, monospace; border: 1px solid var(--rule); border-bottom-width: 2px; border-radius: 3px; padding: 0 4px; }
  @media (pointer: coarse) { .pad { display: grid; } .help, #mirrorBtn { display: none; } .map { bottom: 210px; } }
  @media (max-width: 760px) {
    .where { min-width: 0; max-width: calc(100vw - 172px); } .where .street { font-size: 15px; }
    .where .meta { gap: 6px; font-size: 11px; }
    .tools { width: 120px; } .tools .row { flex-wrap: nowrap; }
    .tools button { padding: 7px 5px; font-size: 10px; flex: 1; white-space: nowrap; }
    #mirrorBtn { display: none; }
    .quest { top: 142px; width: 160px; font-size: 12px; padding: 8px; }
    .quest .timer { font-size: 23px; }
    .seeker { gap: 6px; } #seekerCompass { width: 72px; height: 72px; }
    .seeker-copy strong, #seekerHeading { font-size: 10px; }
    .map { width: 140px; top: 220px; bottom: auto; padding: 8px; }
    #minimap { height: 170px; } .map .legend { gap: 5px; flex-wrap: wrap; }
    .help { display: none; } .mirror { display: none; }
  }
  @media (max-height: 520px) { .quest { top: 108px; gap: 3px; } .quest .detail, #records, .help, .map .detail { display: none; } .map { top: auto; bottom: 12px; right: 215px; width: 160px; } #minimap { height: 110px; } #seekerCompass { width: 52px; height: 52px; } .seeker { padding: 2px 0; } .quest .status { min-height: 0; } }
</style>
</head>
<body>
<canvas id="drive" aria-label="3D view of San Francisco from behind your car"></canvas>
<div class="mirror" id="mirrorFrame" aria-hidden="true"></div>
<div class="panel where" aria-live="polite">
  <div class="street" id="street">Loading the city around you…</div>
  <div class="next" id="next"></div>
  <div class="meta"><span class="speed" id="speed">0 mph</span><span id="compass">N</span><span id="tiles">0 tiles</span></div>
</div>
<div class="panel tools">
  <label for="places">Start from</label>
  <select id="places"></select>
  <div class="row">
    <button type="button" id="mirrorBtn" aria-pressed="true">Mirror</button>
    <button type="button" id="viewBtn" aria-pressed="false">High view</button>
  </div>
  <div class="row">
    <button type="button" id="restartBtn">New trial</button>
    <button type="button" id="respawnBtn">Reset car</button>
  </div>
</div>
<div class="panel quest" aria-label="Emoji time trial">
  <div class="title">San Francisco emoji rally</div>
  <div class="timer" id="timer" role="timer" aria-label="Elapsed trial time">0:00.00</div>
  <div id="progress">Loading the quest…</div>
  <progress id="progressBar" value="0" max="1" aria-label="Emojis collected"></progress>
  <div class="seeker" aria-label="Emoji compass seeker">
    <canvas id="seekerCompass" width="96" height="96" role="img" aria-label="Compass and direction to the emoji on this tile"></canvas>
    <div class="seeker-copy">
      <strong id="seekerScope">This tile</strong>
      <span id="seekerDistance"></span>
      <span id="seekerHeading"></span>
    </div>
  </div>
  <div class="target" id="target"></div>
  <div class="status" id="status" role="status">Drive to start the clock.</div>
  <div class="detail" id="best">Personal best —</div>
  <div class="detail" id="records"></div>
</div>
<div class="panel map" aria-label="City minimap and assets">
  <div class="title">City coverage</div>
  <canvas id="minimap" role="img" aria-label="North-up minimap: loaded tiles in teal, collected tiles in gold, your car in white, and a line to the emoji on this tile or the next target."></canvas>
  <div class="legend"><span class="loaded">■ Loaded</span><span class="collected">■ Collected</span><span>● Quest</span></div>
  <div class="detail" id="assets"></div>
  <div class="detail" id="gameSize"></div>
  <div class="detail" id="coverage"></div>
</div>
<div class="panel help">
  <p><kbd>↑</kbd> <kbd>↓</kbd> or <kbd>W</kbd> <kbd>S</kbd> drive, <kbd>←</kbd> <kbd>→</kbd> or <kbd>A</kbd> <kbd>D</kbd> steer, <kbd>space</kbd> brake, <kbd>M</kbd> mirror, <kbd>V</kbd> view, <kbd>R</kbd> return to an intersection. Follow the compass arrow to this tile's emoji. A crash spins the car for 2 seconds, then resets it; the clock keeps running. New trial or a new start resets the run.</p>
  <p>Measured geometry as context, not a survey or a plan: building outlines and 2010 heights from DataSF (PDDL), roofs fitted to USGS 3DEP lidar flown April 2023 (public domain), street trees from DataSF's Street Tree List with lidar canopy, streets, kerbs (2016) and street names from DataSF. Buildings 3DEP sees that the City's 2010 outlines lack are shaded violet. <a href="https://github.com/banshee-data/velocity.report/blob/main/docs/geometry-priors-data-purpose.md">About this data</a>.</p>
</div>
<div class="pad" aria-label="Driving controls">
  <span></span><button type="button" data-act="up" aria-label="Accelerate">▲</button><span></span>
  <button type="button" data-act="left" aria-label="Steer left">◀</button><button type="button" data-act="brake" aria-label="Brake">■</button><button type="button" data-act="right" aria-label="Steer right">▶</button>
  <span></span><button type="button" data-act="down" aria-label="Reverse">▼</button><span></span>
</div>
<script type="module">
  import { startDrive } from "{{ (modulesBase + '/js/sf-drive.js') | url }}";
  const $ = (id) => document.getElementById(id);
  startDrive({
    canvas: $("drive"),
    base: "{{ '/sf/tiles/' | url }}",
    downloadAssets: {{ sfDownloadAssets | safe }},
    hud: {
      street: $("street"), next: $("next"), speed: $("speed"), compass: $("compass"), tiles: $("tiles"),
      places: $("places"), mirrorBtn: $("mirrorBtn"), viewBtn: $("viewBtn"), mirrorFrame: $("mirrorFrame"),
      restartBtn: $("restartBtn"), respawnBtn: $("respawnBtn"), minimap: $("minimap"),
      timer: $("timer"), progress: $("progress"), progressBar: $("progressBar"), target: $("target"),
      seekerCompass: $("seekerCompass"), seekerScope: $("seekerScope"), seekerDistance: $("seekerDistance"), seekerHeading: $("seekerHeading"),
      status: $("status"), best: $("best"), records: $("records"), assets: $("assets"), gameSize: $("gameSize"), coverage: $("coverage"),
      touchButtons: document.querySelectorAll(".pad button"),
    },
  }).catch((e) => {
    $("street").textContent = "The city tiles could not be loaded.";
    console.error(e);
  });
</script>
</body>
</html>
