---
permalink: /sf/
title: "Drive San Francisco: velocity.report"
description: "Drive anywhere in San Francisco over measured geometry: buildings and roofs from USGS 3DEP lidar and DataSF footprints, street trees, roads with kerbs, and street-name signposts."
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/scene-colours.css">
<link rel="stylesheet" href="/css/fonts.css">
<style>
  /* Full-viewport drive: the 3D view fills the page; the readout, controls and mirror float over it. */
  :root {
    color-scheme: dark;
    --bg: var(--scene-canvas); --panel: var(--scene-panel); --ink: var(--scene-text);
    --muted: var(--scene-text-soft); --rule: var(--scene-panel-border); --accent: var(--scene-primary-text);
    --sky: #0b141f; --land: #182925; --dash: #e5cc80; --pole: #91a5b0; --sign: #185541;
    --map-water: #101e2a; --map-land: #293539; --map-coast: #7397aa; --map-grid: #b0c4cb66;
    --map-park: #39725eaa; --map-arterial: #b2a594a6;
    --hud-bottom: max(12px, env(safe-area-inset-bottom, 0px));
    --pad-size: 56px;
    --sans: "Geist", system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }
  * { box-sizing: border-box; }
  [hidden] { display: none !important; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--bg); color: var(--ink); font: 14px/1.4 var(--sans); overflow: hidden; }
  #drive { position: fixed; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 12px; }
  .drive-bar { position: fixed; top: max(8px, env(safe-area-inset-top, 0px)); left: max(8px, env(safe-area-inset-left, 0px)); right: max(8px, env(safe-area-inset-right, 0px)); height: 48px; max-width: 620px; display: flex; align-items: center; gap: 10px; padding: 2px 2px 2px 10px; }
  .where { flex: 1; min-width: 0; line-height: 1.25; }
  .street, .next { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .street { font-weight: 700; font-size: 13px; }
  .next { color: var(--muted); font-size: 11px; min-height: 14px; }
  .drive-bar[data-crash="true"] .next { color: #f97316; font-weight: 700; }
  .speed { display: flex; align-items: baseline; gap: 2px; flex: none; white-space: nowrap; font-variant-numeric: tabular-nums; }
  #speed { font: 800 26px/1 var(--mono); }
  .speed small { font-size: 10px; font-weight: 600; }
  .run { text-align: right; white-space: nowrap; font-size: 10px; color: var(--muted); }
  .timer { display: block; color: var(--ink); font: 700 14px/1.2 var(--mono); font-variant-numeric: tabular-nums; }
  button, select { font: inherit; color: var(--ink); border: 1px solid var(--rule); border-radius: 8px; background: var(--panel); }
  button { cursor: pointer; touch-action: manipulation; user-select: none; -webkit-user-select: none; }
  button:disabled { opacity: 0.5; cursor: default; }
  button:focus-visible, select:focus-visible, a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .icon-button { width: 44px; height: 44px; flex: none; font-size: 22px; }
  .seeker { position: fixed; top: calc(max(8px, env(safe-area-inset-top, 0px)) + 56px); left: max(8px, env(safe-area-inset-left, 0px)); display: flex; flex-direction: column; align-items: center; gap: 3px; width: min(84px, calc(25vw - 8px)); height: 148px; padding: 4px 2px; background: #12232ef2; color: #fff; border: 2px solid #fbbf24; border-radius: 14px; pointer-events: none; text-align: center; }
  #seekerCompass { width: 64px; height: 64px; display: block; flex: none; }
  .seeker-copy { display: grid; gap: 3px; min-width: 0; max-width: 100%; line-height: 1.15; }
  #seekerDistance { order: -1; font-size: 12px; font-weight: 800; white-space: nowrap; font-variant-numeric: tabular-nums; }
  #seekerTurn { color: #fde68a; font-size: 11px; }
  #seekerScope { font-size: 10px; font-weight: 400; color: #d4dce2; }
  #seekerHeading { display: none; }
  .survey-overlay {
    position: fixed; left: max(12px, env(safe-area-inset-left, 0px));
    bottom: calc(var(--hud-bottom) + var(--survey-clearance, 0px));
    width: min(204px, calc(100vw - 24px)); padding: 6px 8px; border-radius: 8px;
    border-left: 2px solid var(--scene-vehicle); box-shadow: 0 8px 20px #0008;
  }
  .survey-card h2, .survey-approach strong { margin: 2px 0 3px; font-size: 13px; line-height: 1.2; }
  .survey-status, .survey-metric, .survey-approach-label, #surveyApproachDistance { font: 10px/1.3 var(--mono); }
  .survey-status, .survey-approach-label { color: var(--accent); }
  .survey-metric, .survey-approach-line { display: flex; justify-content: space-between; gap: 4px; }
  .survey-metric { color: var(--muted); }
  #surveyP85, #surveyApproachDistance { white-space: nowrap; color: var(--ink); }
  .survey-approach strong { display: block; margin-bottom: 0; }
  .survey-chart svg { display: block; width: 100%; height: auto; }
  .survey-card a { display: flex; width: fit-content; align-items: center; gap: 3px; min-height: 24px; color: var(--accent); font-size: 12px; font-weight: 600; }
  @media (pointer: coarse), (max-width: 760px) {
    :root { --survey-clearance: calc(var(--pad-size) + 8px); }
  }
  @media (orientation: landscape) and (max-height: 390px) {
    .seeker { left: auto; right: max(8px, env(safe-area-inset-right, 0px)); }
  }
  .mirror { position: fixed; top: calc(max(8px, env(safe-area-inset-top, 0px)) + 56px); left: 50%; transform: translateX(-50%); width: min(220px, calc(25vw - 8px)); aspect-ratio: 3.2; border: 2px solid #111; border-radius: 8px; pointer-events: none; box-shadow: 0 2px 8px rgba(0,0,0,.35); }
  .pad { position: fixed; bottom: var(--hud-bottom); display: none; gap: 8px; }
  .steering { left: max(12px, env(safe-area-inset-left, 0px)); }
  .pedals { right: max(12px, env(safe-area-inset-right, 0px)); }
  .pad, .pad button { touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
  .pad button { width: var(--pad-size); height: var(--pad-size); padding: 0; font-size: 28px; font-weight: 750; -webkit-tap-highlight-color: transparent; box-shadow: 0 2px 12px #0003; }
  .pedals [data-act="up"] { border-color: var(--accent); }
  .pad button.held { background: var(--accent); color: var(--scene-primary-ink); border-color: var(--accent); transform: translateY(2px); }
  dialog { width: min(380px, calc(100vw - 24px)); max-height: calc(100dvh - 32px); margin: auto; padding: 16px; color: var(--ink); overscroll-behavior: contain; overflow-y: auto; }
  dialog::backdrop { background: #071018a6; }
  .menu-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .menu-heading h1 { font-size: 18px; margin: 0; }
  .tools { display: grid; gap: 8px; }
  .tools label { font-size: 12px; color: var(--muted); }
  .tools select { width: 100%; min-height: 44px; font-size: 16px; padding: 6px; }
  .tools input { width: 100%; min-height: 44px; font: inherit; font-size: 16px; color: var(--ink); border: 1px solid var(--rule); border-radius: 8px; background: var(--panel); padding: 6px; }
  .tools .row { display: flex; gap: 8px; }
  .tools button { min-height: 44px; padding: 8px 12px; flex: 1; }
  .tools button[aria-pressed="true"] { border-color: var(--accent); }
  .details, .map, .sources, .help { margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--rule); }
  .title { font-weight: 700; }
  .detail, .legend, .meta, .help { font-size: 11px; color: var(--muted); }
  .meta, .legend { display: flex; flex-wrap: wrap; gap: 10px; }
  .details { display: grid; gap: 6px; }
  .details progress { width: 100%; height: 7px; accent-color: var(--accent); }
  #minimap { display: block; width: 100%; height: 220px; }
  #desktopMap { display: none; position: fixed; right: 12px; bottom: 12px; width: min(260px, 34vw); height: min(193px, 35vh); pointer-events: none; }
  @media (pointer: fine) { #desktopMap { display: block; } }
  .map .loaded { color: var(--accent); } .map .collected { color: #fbbf24; } .map .survey-dot { color: var(--scene-vehicle); }
  .help p { margin: 0 0 8px; }
  .help a { color: var(--accent); }
  kbd { font: 11px ui-monospace, monospace; border: 1px solid var(--rule); border-bottom-width: 2px; border-radius: 3px; padding: 0 4px; }
  @media (pointer: coarse), (max-width: 760px) { .pad { display: flex; } }
  @media (max-height: 600px) {
    :root { --pad-size: 48px; }
    .seeker { width: min(76px, calc(25vw - 8px)); height: 128px; padding: 3px 2px; gap: 3px; }
    #seekerCompass { width: 56px; height: 56px; }
    #seekerDistance { font-size: 11px; }
    #seekerTurn { font-size: 10px; }
    .pad { gap: 6px; }
    .pad button { font-size: 25px; }
  }
  body[data-solo="true"] .seeker, body[data-solo="true"] .map,
  body[data-solo="true"] #desktopMap, body[data-solo="true"] .details,
  body[data-solo="true"] #trialArea, body[data-solo="true"] label[for="trialArea"],
  body[data-solo="true"] #places, body[data-solo="true"] label[for="places"] { display: none; }
  body:not([data-solo="true"]) #soloDetails { display: none; }
  #soloTrace { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 240px; overflow: auto; }
  body[data-bridge="true"] .seeker, body[data-bridge="true"] .details { display: none; }
  .airtime { position: fixed; right: 12px; bottom: 12px; width: min(280px, 64vw); padding: 7px 9px; pointer-events: none; }
  .airtime canvas { display: block; width: 100%; height: auto; }
  body:has(.airtime:not([hidden])) #desktopMap { display: none; }
  @media (pointer: coarse), (max-width: 760px) {
    .airtime { right: 8px; bottom: 82px; }
  }
</style>
</head>
<body>
<canvas id="drive" aria-label="Zoomed-out 3D view of San Francisco"></canvas>
<div class="mirror" id="mirrorFrame" aria-hidden="true" hidden></div>
<header class="panel drive-bar" id="driveBar" aria-label="Driving status">
  <div class="where">
    <div class="street" id="street">Loading the city…</div>
    <div class="next" id="next" role="status"></div>
  </div>
  <span class="speed"><span id="speed">0</span><small>mph</small></span>
  <div class="run">
    <span class="timer" id="timer" role="timer" aria-label="Elapsed trial time">0:00.00</span>
    <span id="progress">0 emojis</span>
  </div>
  <button type="button" class="icon-button" id="menuBtn" aria-label="Map and game settings" aria-haspopup="dialog" aria-controls="gameMenu" aria-expanded="false">☰</button>
</header>
<div class="seeker" aria-label="Direction to next emoji">
  <canvas id="seekerCompass" width="144" height="144" role="img" aria-label="Direction to the next emoji, relative to the car"></canvas>
  <div class="seeker-copy">
    <strong id="seekerTurn">Follow arrow</strong>
    <span id="seekerScope">This tile</span>
    <span id="seekerDistance"></span>
    <span id="seekerHeading"></span>
  </div>
</div>
<div class="panel survey-overlay survey-approach" id="surveyApproach" hidden>
  <div class="survey-approach-line">
    <span class="survey-approach-label"><span aria-hidden="true">◆</span> Survey ahead</span>
    <span id="surveyApproachDistance"></span>
  </div>
  <strong id="surveyApproachTitle" role="status" aria-label="Survey ahead"></strong>
</div>
<aside class="panel survey-overlay survey-card" id="surveyCard" aria-labelledby="surveyTitle" hidden>
  <div class="survey-status" id="surveyStatus" role="status"></div>
  <h2 id="surveyTitle"></h2>
  <div class="survey-metric"><span>Peak speeds</span><strong id="surveyP85"></strong></div>
  <div class="survey-chart" id="surveyChart"></div>
  <a id="surveyLink" target="_blank" rel="noopener" aria-label="View survey (opens in a new tab)">View survey <span aria-hidden="true">→</span></a>
</aside>
<canvas class="panel" id="desktopMap" role="img" aria-label="City coverage showing the coastline, parks, major roads, S2 tiles and your car."></canvas>
<section class="panel airtime" id="airtime" aria-label="Airtime and road elevation" hidden>
  <strong id="airtimeReadout"></strong>
  <canvas id="airtimePlot" width="520" height="208" aria-label="Road centreline elevation, flight path and current car altitude"></canvas>
</section>
<dialog class="panel" id="gameMenu" aria-labelledby="menuTitle">
  <div class="menu-heading">
    <h1 id="menuTitle">Map &amp; game</h1>
    <form method="dialog"><button class="icon-button" aria-label="Close settings">×</button></form>
  </div>
  <div class="tools">
    <label for="gameMode">Game mode</label>
    <select id="gameMode"><option value="city">City emoji time trial</option><option value="solo">Solo safety practice</option></select>
    <label for="viewMode">Camera</label>
    <select id="viewMode">
      <option value="zoomed" selected>Zoomed out</option>
      <option value="overhead">Overhead</option>
      <option value="incar">In car</option>
    </select>
    <button type="button" id="mirrorBtn" aria-pressed="true" hidden>Rear-view mirror</button>
    <label for="trialArea">Time trial</label>
    <select id="trialArea" aria-label="Time trial area"></select>
    <label for="places">Start from</label>
    <select id="places"></select>
    <a href="?at=bay-bridge-deck" id="bridgeLink" hidden>Drive the Bay Bridge approach</a>
    <div class="row">
      <button type="button" id="restartBtn">New trial</button>
      <button type="button" id="respawnBtn">Reset car</button>
    </div>
  </div>
  <details class="sources" id="mapSources">
    <summary>Map sources</summary>
    <form id="sourceForm" class="tools" aria-label="Map sources">
      <label for="tileServer">SF tile directory or manifest URL</label>
      <input type="text" id="tileServer" inputmode="url" placeholder="Bundled SF tiles" spellcheck="false" autocomplete="off">
      <label for="gerardusServer">Gerardus address or overlay manifest URL</label>
      <input type="text" id="gerardusServer" inputmode="url" placeholder="Optional road surfaces" spellcheck="false" autocomplete="off">
      <p class="detail">Use a compatible planar SF tile pack. Leave the fields blank for the bundled map.</p>
      <button type="submit">Apply map sources</button>
      <p id="sourceError" class="detail" role="status"></p>
    </form>
  </details>
  <section id="soloDetails" aria-labelledby="soloTitle">
    <h2 id="soloTitle">Solo safety practice</h2>
    <p>Drive east over the crest to the white finish line, 300 m from the start. Close this menu and accelerate to begin. Stay on the road; there is no reward for faster time.</p>
    <p>This is an authored practice course, not Harrison or a surveyed street. The practice limit is 20 mph up to the gold line; the last 50 m has an unknown limit. Kerbs are authored at 15 cm.</p>
    <p>Opening the menu pauses driving and excludes that simulation time. Restarting aborts this attempt and starts fresh; city pickups and records stay separate.</p>
    <p id="soloSummary"></p>
    <details><summary>Event evidence (simulation seconds)</summary><pre id="soloTrace"></pre></details>
    <details><summary>Previous attempt (this session)</summary><p id="soloPrevious">No previous attempt.</p></details>
  </section>
  <div class="details" aria-label="Emoji time trial">
    <div class="title" id="trialTitle">San Francisco emoji rally</div>
    <progress id="progressBar" value="0" max="1" aria-label="Emojis collected"></progress>
    <div id="target"></div>
    <div id="status">Drive to start the clock.</div>
    <div class="detail" id="best">Personal best —</div>
    <div class="detail" id="records"></div>
    <div class="meta"><span id="compass">N</span><span id="tiles">0 tiles</span></div>
  </div>
  <div class="map" aria-label="City minimap and assets">
    <div class="title">City coverage</div>
    <canvas id="minimap" role="img" aria-label="North-up S2 level-13 coverage map with coastline, parks and major roads. Loaded tiles are teal, collected tiles are gold, survey sites are red diamonds and your car is white."></canvas>
    <div class="legend"><span class="loaded">■ Loaded</span><span class="collected">■ Collected</span><span class="survey-dot">◆ Survey</span></div>
    <div class="detail" id="assets"></div>
    <div class="detail" id="gameSize"></div>
    <div class="detail" id="coverage"></div>
  </div>
  <div class="help">
    <p>Steer with the left thumb. Use the right thumb to accelerate or brake. Keep holding the brake to reverse after stopping. Follow the gold arrow to the indicated emoji. Camera choices are Zoomed out, Overhead and In car. The mirror is available only in car view.</p>
    <p><kbd>↑</kbd> <kbd>↓</kbd> or <kbd>W</kbd> <kbd>S</kbd> drive/reverse, <kbd>←</kbd> <kbd>→</kbd> or <kbd>A</kbd> <kbd>D</kbd> steer, <kbd>space</kbd> brake, <kbd>M</kbd> mirror in car, <kbd>V</kbd> cycle cameras, <kbd>R</kbd> return to an intersection. A crash spins the car for 2 seconds, then resets it; the clock keeps running. New trial or a new start resets the run. The clock also continues while this menu is open.</p>
    <p>Measured geometry as context, not a survey or a plan: building outlines and 2010 heights from DataSF (PDDL), roofs fitted to USGS 3DEP lidar flown April 2023 (public domain), street trees from DataSF's Street Tree List with lidar canopy, streets, kerbs (2016) and street names from DataSF. Buildings 3DEP sees that the City's 2010 outlines lack use a warmer tan. <a href="https://github.com/banshee-data/velocity.report/blob/main/docs/geometry-priors-data-purpose.md">About this data</a>.</p>
  </div>
</dialog>
<div class="pad steering" role="group" aria-label="Steering controls">
  <button type="button" data-act="left" aria-label="Steer left">←</button>
  <button type="button" data-act="right" aria-label="Steer right">→</button>
</div>
<div class="pad pedals" role="group" aria-label="Accelerator and brake">
  <button type="button" data-act="brake" aria-label="Brake or hold to reverse">▼</button>
  <button type="button" data-act="up" aria-label="Accelerate">▲</button>
</div>
<script type="application/json" id="surveySites">{{ surveys | sfSurveyData | safe }}</script>
<script type="module">
  import { mountDriveSettings } from "{{ (modulesBase + '/js/sf-drive-settings.js') | url }}";
  const $ = (id) => document.getElementById(id);
  const sources = mountDriveSettings({
    menu: $("gameMenu"), menuButton: $("menuBtn"), form: $("sourceForm"),
    tiles: $("tileServer"), gerardus: $("gerardusServer"), error: $("sourceError"),
  });
  import("{{ (modulesBase + '/js/sf-drive.js') | url }}").then(({ startDrive }) => startDrive({
    canvas: $("drive"),
    base: "{{ '/sf/tiles/' | url }}",
    sources,
    downloadAssets: {{ sfDownloadAssets | safe }},
    surveySites: JSON.parse($("surveySites").textContent),
    hud: {
      gameMode: $("gameMode"), soloSummary: $("soloSummary"), soloTrace: $("soloTrace"), soloPrevious: $("soloPrevious"),
      street: $("street"), next: $("next"), speed: $("speed"), compass: $("compass"), tiles: $("tiles"),
      places: $("places"), mirrorBtn: $("mirrorBtn"), viewMode: $("viewMode"), mirrorFrame: $("mirrorFrame"),
      menu: $("gameMenu"), menuBtn: $("menuBtn"), driveBar: $("driveBar"),
      restartBtn: $("restartBtn"), respawnBtn: $("respawnBtn"), minimap: $("minimap"), desktopMap: $("desktopMap"),
      timer: $("timer"), progress: $("progress"), progressBar: $("progressBar"), target: $("target"),
      seekerCompass: $("seekerCompass"), seekerScope: $("seekerScope"), seekerDistance: $("seekerDistance"), seekerHeading: $("seekerHeading"),
      seekerTurn: $("seekerTurn"), trialArea: $("trialArea"), trialTitle: $("trialTitle"),
      status: $("status"), best: $("best"), records: $("records"), assets: $("assets"), gameSize: $("gameSize"), coverage: $("coverage"),
      bridgeLink: $("bridgeLink"), airtime: $("airtime"), airtimeReadout: $("airtimeReadout"), airtimePlot: $("airtimePlot"),
      touchButtons: document.querySelectorAll(".pad button"),
      survey: {
        approach: $("surveyApproach"), approachTitle: $("surveyApproachTitle"), approachDistance: $("surveyApproachDistance"),
        card: $("surveyCard"), status: $("surveyStatus"), title: $("surveyTitle"),
        p85: $("surveyP85"), chart: $("surveyChart"), link: $("surveyLink"),
      },
    },
  })).catch((e) => {
    $("street").textContent = "The city tiles could not be loaded.";
    $("next").textContent = "Open Map & game to change map sources.";
    $("mapSources").open = true;
    console.error(e);
  });
</script>
</body>
</html>
