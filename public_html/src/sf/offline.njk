---
permalink: /sf/offline.js
eleventyExcludeFromCollections: true
---
const scope = new URL(self.registration.scope);
const modules = new URL("{{ (modulesBase + '/js/') | url }}", scope);
const tiles = new URL("tiles/", scope);
const version = "{{ sfTileVersion }}";
const shellCache = `sf-shell-${modules.pathname}-${version}`;
const tileCache = `sf-tiles-${scope.pathname}-${version}`;
const assets = [
  scope.href,
  new URL("../css/scene-colours.css", scope).href,
  new URL("../css/fonts.css", scope).href,
  ...{{ sfDownloadAssets | safe }}.map((asset) =>
    new URL(asset.url, asset.base === "modules" ? modules : tiles).href
  ),
];

self.addEventListener("install", (event) => {
  event.waitUntil(
    caches.open(shellCache).then((cache) =>
      cache.addAll(assets.map((url) => new Request(url, { cache: "reload" }))),
    ).then(() => self.skipWaiting()),
  );
});

self.addEventListener("activate", (event) => {
  event.waitUntil(self.clients.claim());
});

async function tileResponse(request) {
  const cache = await caches.open(tileCache);
  const stored = await cache.match(request);
  if (stored) return stored;
  const response = await fetch(request);
  if (response.ok) {
    try {
      await cache.put(request, response.clone());
    } catch {
      // Quota and eviction can limit offline coverage without breaking play.
    }
  }
  return response;
}

// Both passive streaming and bulk downloads use the active map revision's cache.
let bulkDownload = null;

async function downloadTiles(report) {
  const shell = await caches.open(shellCache);
  const response = await shell.match(new URL("manifest.json", tiles));
  const manifest = await response?.json();
  if (!manifest?.tiles?.length || !manifest.tiles.every(({ t }) => /^[0-9a-f]{8}$/.test(t)))
    throw new Error("The offline tile list is unavailable.");
  const tokens = [...new Set(manifest.tiles.map(({ t }) => t))];
  const cache = await caches.open(tileCache);
  let next = 0;
  let checked = 0;
  let saved = 0;
  let storageError = false;
  const progress = () => ({ saved, total: tokens.length, storageError });
  report({ type: "progress", ...progress() });

  async function fill() {
    while (next < tokens.length) {
      const url = new URL(`${tokens[next++]}.json.gz`, tiles);
      try {
        const cached = await cache.match(url);
        if (cached?.ok) {
          saved++;
        } else if (!storageError) {
          const tile = await fetch(url, { signal: AbortSignal.timeout(15000) });
          if (tile.ok) {
            try {
              await cache.put(url, tile);
              saved++;
            } catch (error) {
              // Cache.put also consumes the network response body. A dropped
              // transfer is retryable, even after fetch has resolved.
              if (error.name === "QuotaExceededError") storageError = true;
            }
          }
        }
      } catch {
        // Other tiles can still be saved. A retry reuses the successful ones.
      }
      if (++checked % 4 === 0) report({ type: "progress", ...progress() });
    }
  }

  await Promise.all(Array.from({ length: 4 }, fill));
  report({ type: "complete", ...progress() });
}

self.addEventListener("message", (event) => {
  const port = event.ports[0];
  if (event.data?.type !== "download-all-tiles" || !port) return;
  if (!bulkDownload) {
    const job = { ports: new Set(), latest: { type: "progress" } };
    const report = (message) => {
      job.latest = message;
      for (const subscriber of job.ports) subscriber.postMessage(message);
    };
    bulkDownload = job;
    job.done = downloadTiles(report)
      .catch(() => report({ type: "error" }))
      .finally(() => {
        for (const subscriber of job.ports) subscriber.close();
        bulkDownload = null;
      });
  }
  bulkDownload.ports.add(port);
  port.postMessage(bulkDownload.latest);
  event.waitUntil(bulkDownload.done);
});

self.addEventListener("fetch", (event) => {
  const { request } = event;
  const url = new URL(request.url);
  if (request.method !== "GET" || url.origin !== scope.origin) return;
  if (request.mode === "navigate" && url.pathname === scope.pathname) {
    event.respondWith(fetch(request).catch(async () => {
      const cache = await caches.open(shellCache);
      return (await cache.match(scope.href)) || Response.error();
    }));
  } else if (url.href.startsWith(tiles.href) && /^[0-9a-f]{8}\.json\.gz$/.test(url.pathname.split("/").at(-1))) {
    event.respondWith(tileResponse(request));
  } else if (assets.includes(url.href)) {
    event.respondWith(caches.open(shellCache).then(async (cache) =>
      (await cache.match(request)) || fetch(request),
    ));
  }
});
