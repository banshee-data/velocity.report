---
permalink: /sf/roads/
title: Road surface explorer
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="referrer" content="no-referrer">
<title>{{ title }} · velocity.report</title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100dvh; display: grid; grid-template-rows: auto 1fr; background: #101a22; color: #edf4f7; font: 14px/1.4 system-ui, sans-serif; }
  header { display: grid; gap: 8px; padding: 12px 16px; }
  h1, p { margin: 0; }
  h1 { font-size: 19px; }
  a { color: #91dff4; }
  form, .controls, .legend { display: flex; align-items: center; gap: 8px 14px; flex-wrap: wrap; }
  input, button { font: inherit; }
  input[type=url], button { min-height: 38px; border: 1px solid #607986; border-radius: 6px; padding: 5px 10px; }
  input[type=url] { flex: 1 1 16rem; min-width: 0; }
  button { background: #253c4a; color: inherit; cursor: pointer; }
  .legend { color: #d3e2e9; }
  .legend span::before { content: ""; display: inline-block; margin-right: 6px; width: 9px; height: 9px; border-radius: 2px; background: var(--swatch); }
  #scene { display: block; width: 100%; height: 100%; min-height: 320px; touch-action: none; cursor: grab; }
  #scene:active { cursor: grabbing; }
</style>
</head>
<body>
<header>
  <h1>{{ title }} <small>· <a href="{{ '/sf/' | url }}">SF driving game</a></small></h1>
  <form id="source">
    <label for="overlay">Gerardus manifest URL</label>
    <input type="url" id="overlay" required autocomplete="off" spellcheck="false">
    <button type="submit">Load revision</button>
  </form>
  <div class="controls" aria-label="View controls">
    <button type="button" data-view="above">Above</button>
    <button type="button" data-view="below">Under the deck</button>
    <button type="button" data-view="closer" aria-label="Zoom in">+</button>
    <button type="button" data-view="farther" aria-label="Zoom out">−</button>
    <label><input type="checkbox" id="terrain" checked> Game terrain</label>
  </div>
  <div class="legend" aria-label="Surface colours">
    <span style="--swatch:#20b8e0">Bridge deck</span>
    <span style="--swatch:#70d09c">Ground street</span>
    <span style="--swatch:#f6b94b">Interpolated</span>
  </div>
  <p id="status" role="status">Enter a Gerardus overlay manifest. Drag to orbit.</p>
</header>
<canvas id="scene" aria-label="3D view of Gerardus road surfaces and SF game terrain"></canvas>
<script type="module">
  import { mountRoadOverlay } from "{{ (modulesBase + '/js/sf-road-overlay.js') | url }}";
  const $ = (id) => document.getElementById(id);
  $("overlay").value = new URLSearchParams(location.search).get("overlay") || "";
  try {
    mountRoadOverlay({
      canvas: $("scene"), form: $("source"), input: $("overlay"), status: $("status"),
      terrainToggle: $("terrain"), viewButtons: document.querySelectorAll("[data-view]"),
      baseUrl: new URL("{{ '/sf/tiles/manifest.json' | url }}", location.href),
    });
  } catch (error) {
    $("status").textContent = "Could not start the 3D view. Check that your browser supports WebGL.";
    console.error(error);
  }
</script>
</body>
</html>
