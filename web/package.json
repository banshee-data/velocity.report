{
	"name": "velocity.report-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node scripts/set-build-env.js dev pnpm exec vite dev",
		"build": "node scripts/set-build-env.js build pnpm exec vite build",
		"postbuild": "node scripts/copy-build.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"up-deps": "pnpm update -r -i --latest",
		"format": "pnpm run prettier:write",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"lint": "pnpm run prettier:check && pnpm exec eslint .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:ci": "jest --ci --coverage --maxWorkers=2"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@layerstack/tailwind": "2.0.0-next.23",
		"@mdi/js": "^7.4.47",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-scale": "^4.0.9",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"d3-scale": "4.0.2",
		"date-fns": "4.4.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-jester": "^5.0.0",
		"svelte-ux": "2.0.0-next.26",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@layerstack/utils": "2.0.0-next.19",
		"@types/leaflet": "^1.9.22",
		"leaflet": "^1.9.4",
		"qrcode": "^1.5.4"
	}
}
