{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	// $app/tsconfig (generated into node_modules by `svelte-kit sync`) supplies
	// the module settings, checkJs and the $app types, but no include list.
	// SvelteKit suggests ["src", "test", "*"]; "*" would put the CommonJS and
	// Node-only root files (jest.config.js, jest.esbuild-transformer.cjs, …)
	// under checkJs, so only the Vite config is named. There is no test/ here.
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker"]
}
